{
  "name": "audio-extender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --no-clear",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile public/build/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile public/build/smui-dark.css -i src/theme/dark"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@smui/button": "^9.0.2",
    "@smui/card": "^9.0.2",
    "@smui/circular-progress": "^9.0.2",
    "@smui/common": "^9.0.2",
    "@smui/dialog": "^9.0.2",
    "@smui/form-field": "^9.0.2",
    "@smui/icon-button": "^9.0.2",
    "@smui/layout-grid": "^9.0.2",
    "@smui/list": "^9.0.2",
    "@smui/menu": "^9.0.2",
    "@smui/menu-surface": "^9.0.2",
    "@smui/select": "^9.0.2",
    "@smui/slider": "^9.0.2",
    "@smui/snackbar": "^9.0.2",
    "@smui/textfield": "^9.0.2",
    "@smui/top-app-bar": "^9.0.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/audiobuffer-to-wav": "^1.0.4",
    "rollup": "^4.62.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.2.3",
    "rollup-plugin-workbox": "^9.0.0",
    "smui-theme": "^9.0.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "audiobuffer-to-wav": "^1.0.0",
    "cborg": "^6.1.1",
    "idb": "^8.0.3",
    "sirv-cli": "^3.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "svelte-preprocess": false
  }
}
