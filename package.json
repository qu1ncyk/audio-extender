{
  "name": "audio-extender",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --no-clear",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
    "smui-theme-light": "smui-theme compile public/build/smui.css -i src/theme",
    "smui-theme-dark": "smui-theme compile public/build/smui-dark.css -i src/theme/dark"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^21.0.2",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-typescript": "^8.0.0",
    "@smui/button": "^9.0.0",
    "@smui/card": "^9.0.0",
    "@smui/circular-progress": "^9.0.0",
    "@smui/common": "^9.0.0",
    "@smui/dialog": "^9.0.0",
    "@smui/form-field": "^9.0.0",
    "@smui/icon-button": "^9.0.0",
    "@smui/layout-grid": "^9.0.0",
    "@smui/list": "^9.0.0",
    "@smui/menu": "^9.0.0",
    "@smui/menu-surface": "^9.0.0",
    "@smui/select": "^9.0.0-beta.16",
    "@smui/slider": "^9.0.0",
    "@smui/snackbar": "^9.0.0-beta.16",
    "@smui/textfield": "^9.0.0",
    "@smui/top-app-bar": "^9.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/audiobuffer-to-wav": "^1.0.1",
    "rollup": "^2.3.4",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-terser": "^7.0.0",
    "rollup-plugin-workbox": "^6.2.0",
    "smui-theme": "^9.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^4.5.3",
    "@mdi/js": "^6.6.95",
    "audiobuffer-to-wav": "^1.0.0",
    "cborg": "^6.1.1",
    "idb": "^7.0.0",
    "sirv-cli": "^2.0.2"
  }
}
